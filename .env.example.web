# Frontend (Next.js) environment variables
# Copy to .env.web and fill in real values. Never commit secrets.

# Base URL of the Express API (Render in prod, localhost in dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Public site URL (for SEO/meta/sitemap). In prod, your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
