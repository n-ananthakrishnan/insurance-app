# Backend (Express) environment variables
# Copy to .env.api and fill in real values. Never commit secrets.

# PostgreSQL — reuse the shared DATABASE_URL or set here.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT signing secret — generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-256-bit-secret

# bcrypt cost rounds (do not go below 12 in production)
BCRYPT_SALT_ROUNDS=12

# Cloudflare R2 (S3-compatible) — file storage for claim documents
R2_BUCKET=sample-insurance-jp
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
# Optional: base URL for public signed download URLs (if using r2.dev)
R2_PUBLIC_URL=https://pub-replace-with-id.r2.dev

# CORS allowed origins (comma-separated). Include Vercel production +
# preview domains and localhost for development.
CORS_ORIGINS=http://localhost:3000,https://example.vercel.app

# Enable rate limiting (set false only for local debugging)
ENABLE_RATE_LIMIT=true

# Port the API listens on
PORT=3001

# Node environment
NODE_ENV=development
