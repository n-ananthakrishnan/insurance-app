# Shared environment variables (no secrets)
# Copy to .env and fill in real values. Never commit secrets.

# PostgreSQL — use Neon’s pooled URL for normal API requests and direct URL for migrations.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
