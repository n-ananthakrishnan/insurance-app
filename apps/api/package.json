{
  "name": "@sample-insurance/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r ./scripts/node-userinfo-shim.cjs ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node -r ./scripts/node-userinfo-shim.cjs ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:unit": "vitest run src",
    "test:api": "vitest run tests/api"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@types/express-rate-limit": "^5.1.3",
    "bcrypt": "^5.1.1",
    "cookie": "^0.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "rate-limit-redis": "^4.2.0",
    "ulid": "^1.1.1",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie": "^0.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^1.6.0",
    "prisma": "^5.14.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
