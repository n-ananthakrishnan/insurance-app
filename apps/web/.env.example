# Next.js environment for the web app (apps/web).
# Copy to .env.local for local dev; never commit real secrets.

# API base URL the web app calls at runtime.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001/api/v1"

# Same value server-side for server components / loaders.
API_BASE_URL="http://localhost:3001/api/v1"

# Canonical site URL used for links/redirects in pages.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
